# =====================================================================
#  Configuración del laboratorio 92-EAN — copia este archivo a .env
#      cp .env.example .env      y edítalo según tu setup.
#
#  UNA sola variable (LLM_BACKEND) decide el "cerebro" del copiloto.
#  El resto del código NO cambia entre setups. Esa es la clave del taller.
# =====================================================================

# ---- Elige el backend: ollama | groq | openrouter | custom -----------
LLM_BACKEND=ollama

# Temperatura baja = respuestas reproducibles (recomendado para el taller)
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------
#  SETUP 1 — LOCAL / PRIVADO (VM Ubuntu con modelo local)
#  Recomendado si manejas evidencia real. Los datos NUNCA salen del equipo.
# ---------------------------------------------------------------------
# LLM_BACKEND=ollama
# LLM_MODEL=llama3.1:8b            # con >=16 GB RAM. Alternativa liviana: llama3.2:3b
# (Ollama no requiere API key)

# ---------------------------------------------------------------------
#  SETUP 2 y 3 — CLOUD (droplet DigitalOcean / Linode) con API hosted
#  Para máquinas débiles o de trabajo sin permisos. Solo datos SINTÉTICOS.
# ---------------------------------------------------------------------
#  Opción A — Groq (gratis, muy rápida, sin tarjeta). Consíguela en console.groq.com
# LLM_BACKEND=groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=llama-3.3-70b-versatile

#  Opción B — OpenRouter (modelos :free). Consíguela en openrouter.ai/keys
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------------------------------------------------
#  CUSTOM — cualquier endpoint compatible con OpenAI (avanzado)
# ---------------------------------------------------------------------
# LLM_BACKEND=custom
# LLM_BASE_URL=https://mi-endpoint/v1
# LLM_API_KEY=xxxxxxxx
# LLM_MODEL=mi-modelo
